# Copy to .env and fill real values before deploying.

DUQB_ENVIRONMENT=development
DUQB_DEBUG=true

# SQLite file lives OUTSIDE the webroot on cPanel, e.g.:
# DUQB_DATABASE_URL=sqlite:////home/CPANEL_USER/data/duqbank/app.db
DUQB_DATABASE_URL=sqlite:///./duqbank.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DUQB_SECRET_KEY=change-me-to-a-long-random-string
DUQB_ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# Comma separated, or * for all. Example: https://admin.example.com,https://app.example.com
DUQB_CORS_ORIGINS=*

DUQB_RATE_LIMIT_PER_MINUTE=120
DUQB_AUTH_RATE_LIMIT_PER_MINUTE=20
DUQB_DEFAULT_PAGE_SIZE=25
DUQB_MAX_PAGE_SIZE=100

# Run "alembic upgrade head" automatically when the app boots (i.e. after every deploy).
# Useful on cPanel where the FTP deploy restarts Passenger but cannot run shell commands.
DUQB_AUTO_MIGRATE=false
